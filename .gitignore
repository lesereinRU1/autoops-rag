# Python virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Environment / secrets
.env
*.env
.env.*
!.env.example

# Local models
models/*
!models/.gitkeep

# Local vector/database storage
storage/*
!storage/.gitkeep

# Raw and processed data
# Raw manuals and third-party source documents stay local and are not distributed.
data/raw/
data/processed/*
!data/processed/.gitkeep

# Reports
reports/*.json
reports/rag_traces.jsonl
reports/*.csv

# Local cache/temp
.cache/
.tmp/

# React/Vite local dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Runtime logs
reports/*.log
reports/*.err.log
reports/*.out.log
reports/*_final*.log
reports/reindex*.log

# Local draft / raw manual files
data/eval/formal_questions_draft_011_030.jsonl
