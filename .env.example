# 所有相对路径都以项目根目录为基准
APP_HOST=127.0.0.1
APP_PORT=8000
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
ENABLE_RERANKER=false
ENABLE_BM25=true
ENABLE_TABLE_EXTRACTION=true
RERANKER_MODEL=BAAI/bge-reranker-base
QDRANT_COLLECTION=autoops_manuals
# 小型演示集合使用较少 segment，并在约 5 MB/segment 时构建 HNSW。
QDRANT_INDEXING_THRESHOLD_KB=5000
QDRANT_DEFAULT_SEGMENT_NUMBER=2
CHUNK_SIZE=450
CHUNK_OVERLAP=60
ENABLE_QUERY_EXPANSION=false

# 单机默认使用本地Qdrant。迁移到Qdrant Server后填写URL，可支持多进程访问。
QDRANT_URL=
QDRANT_API_KEY=

# 接口并发保护。检索改为并发读，重建索引仍为独占写操作。
MAX_CONCURRENT_QUERIES=8
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_MAX_CLIENTS=10000

# 索引重建属于管理操作。留空时 /api/index/ingest 默认禁用。
INDEX_ADMIN_API_KEY=

# 可选：接入任何 OpenAI 兼容接口。留空时使用本地证据式回答，不影响检索功能。
LLM_ENABLED=false
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_api_key_here
# 首选模型。保留LLM_MODEL作为旧配置兼容项；MODEL_NAME未设置时会读取LLM_MODEL。
MODEL_NAME=qwen-plus
MODEL_FALLBACKS=qwen3.7-plus,qwen-plus-2025-07-28,qwen-max,glm-5,deepseek-r1-distill-qwen-7b
# LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=40
LLM_TRANSPORT_RETRIES=1
