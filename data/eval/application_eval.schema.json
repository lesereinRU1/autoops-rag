{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoOps应用层评测题",
  "type": "object",
  "required": [
    "id", "split", "category", "question", "model", "answerable",
    "gold_chunk_ids", "expected_tool", "required_fact_groups",
    "source_scope", "review_status"
  ],
  "properties": {
    "id": {"type": "string"},
    "split": {"enum": ["development", "regression"]},
    "category": {"type": "string"},
    "question": {"type": "string", "minLength": 1},
    "model": {"type": "string"},
    "answerable": {"type": "boolean"},
    "gold_chunk_ids": {"type": "array", "items": {"type": "string"}},
    "expected_tool": {"enum": ["search_manual", "lookup_alarm_code", "check_parameter_range"]},
    "required_fact_groups": {
      "type": "array",
      "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    },
    "source_scope": {"enum": ["official_manual", "project_supplement", "none"]},
    "review_status": {"enum": ["self_checked", "independent_reviewed", "pending"]},
    "notes": {"type": "string"}
  }
}
